DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=instagram_clone

APP_ENV=development
SECRET_KEY=replace_with_a_long_random_secret
SESSION_MAX_AGE_SECONDS=604800
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
SQLALCHEMY_ECHO=false
HEALTH_CHECK_CACHE_SECONDS=5

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
# Optional. Omit to use Neo4j's configured default database.
# NEO4J_DATABASE=your_neo4j_database

# Optional feed ranking configuration.
# FEED_RECENCY_WEIGHT=0.55
# FEED_SOCIAL_WEIGHT=0.30
# FEED_ENGAGEMENT_WEIGHT=0.15
# FEED_INTEREST_WEIGHT=0.15
# FEED_RECENCY_HALF_LIFE_HOURS=48
# FEED_CANDIDATE_LIMIT=500
# FEED_PAGE_SIZE=20
